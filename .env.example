# =====================================================================
# EcoSurv — gabarit de variables d'environnement
#
# Copier ce fichier en `.env.local` et y mettre les valeurs reelles.
# `.env` et `.env.local` sont ignores par Git (voir GIT_RULES.md §5).
# CE FICHIER-CI est versionne : il ne doit JAMAIS contenir de valeur reelle.
#
# Regle de separation des cles : SECURITY_RULES.md §3.
# Detail de chaque variable : BACKEND_AGENT.md §7.
# =====================================================================

# ---------------------------------------------------------------------
# FRONTEND (Vite)
# Le prefixe VITE_ expose la variable au navigateur : n'y mettre que du
# public. L'URL du projet est rappelee dans SECURITY_RULES.md §0.
# ---------------------------------------------------------------------

VITE_SUPABASE_URL=https://votre-projet.supabase.co

# Cle publique. Publique par conception : elle ne donne acces qu'a ce que
# les policies RLS autorisent. A recuperer dans
# Project Settings > Data API > Project API keys > anon / public.
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------
# BACKEND — EDGE FUNCTIONS UNIQUEMENT
#
# SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY sont deja injectees
# automatiquement dans l'environnement d'execution des Edge Functions
# Supabase : ne les redeclarer que pour un usage local (supabase functions
# serve) ou un backend heberge ailleurs.
# ---------------------------------------------------------------------

SUPABASE_URL=https://votre-projet.supabase.co

# ##  CRITIQUE  ##
# Contourne TOUTES les policies RLS. Une fuite equivaut a un acces total
# aux donnees de toutes les ecoles. Jamais dans le frontend, jamais dans un
# commit, jamais transmise a un agent IA. Laisser vide ici.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# PAIEMENT MOBILE MONEY
# Noms provisoires : l'operateur retenu (Bankily / Masrvi / Sedad) est une
# hypothese a valider — cahier des charges §5.3. Renommer une fois arrete.
# ---------------------------------------------------------------------

MOBILE_MONEY_BASE_URL=
MOBILE_MONEY_API_KEY=
MOBILE_MONEY_API_SECRET=

# Secret de signature des callbacks. Sans verification de cette signature,
# n'importe qui pourrait confirmer un paiement (SECURITY_RULES.md §6).
MOBILE_MONEY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# NOTIFICATIONS SMS / WHATSAPP
# ---------------------------------------------------------------------

SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=

WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
